<?xml version="1.0" encoding="utf-8"?>
<!--
    Defesa em profundidade: nenhuma SharedPreferences é incluída em
    cloud-backup ou device-transfer. O armazenamento local continua
    disponível normalmente no aparelho.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
